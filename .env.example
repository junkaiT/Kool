# Base URL of the OpenClaw booking API (e.g. an ngrok tunnel during development).
# Leave unset to see the "booking availability isn't connected yet" fallback state on /book.
#
# There is only ever one value/one running OpenClaw instance — no separate staging URL.
# "Staging" is handled entirely on the OpenClaw/CRM side by temporarily pointing that one
# instance at a staging Google Sheet (see docs/staging-environment.md) rather than by running
# a second website environment.
NEXT_PUBLIC_OPENCLAW_URL=

# --- Analytics & conversion tracking ---
# All optional. Tracking stays completely dormant (no scripts loaded, no events
# fired) until at least one ID below is set. Set these in .env.local locally and
# in the Vercel dashboard for production.
#
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads account/conversion ID, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads conversion labels — the string after the "/" in a conversion's
# send_to value, taken from each conversion action you create in Google Ads.
# Booking is the primary conversion (fires when a booking request is sent on /book).
NEXT_PUBLIC_ADS_LABEL_BOOKING=
# Optional secondary conversions:
NEXT_PUBLIC_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_ADS_LABEL_CALL=
